# ===== AI Coding Agent 后端配置 =====

# 数据库（本机 PostgreSQL）
# 建议使用无特殊字符的专用账号；不要把真实密码提交到版本库
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/coding_agent

# 模型（OpenAI 兼容端点，前端设置页可覆盖）
# 阿里百炼: https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek: https://api.deepseek.com/v1
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL=qwen3.7-flash
OPENAI_API_KEY=

# 各模型服务商凭证（预留空值，按需手动填写；设置页按模型保存的 Key 优先于此处）
# 阿里百炼（qwen3.7-flash / qwen-3.8flash）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
# DeepSeek（deepseek-v4-flash / deepseek-v4-pro）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# Tavily 网络搜索（可选）
TAVILY_API_KEY=

# 命令确认模式: auto | high_risk | all
COMMAND_CONFIRM_MODE=auto

# 服务
HOST=127.0.0.1
PORT=8000

# 跨域配置（逗号分隔的允许来源；* 表示允许所有，如局域网调试）
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 安全（可选）=====
# 设置后所有 /api 请求需带 X-API-Token 或 Authorization: Bearer <token>
# 前端需设置 VITE_API_TOKEN
# API_TOKEN=
# 每 IP 每分钟允许的写请求数（0=不限）
# RATE_LIMIT_PER_MUTATION=120

# ===== 模型调用 =====
# 原生重试次数
# LLM_MAX_RETRIES=2
# 降级模型（主模型失败时；留空不降级）
# FALLBACK_MODEL=

# ===== 上下文 =====
# 摘要触发阈值（估算 token）：>0 显式指定（默认 50000）；0 = 按模型窗口自动计算
# SUMMARY_THRESHOLD_TOKENS=50000
# 自动阈值比例：阈值 = 模型 context_window × 该比例
# SUMMARY_THRESHOLD_RATIO=0.6
# 摘要时保留最近消息条数
# SUMMARY_KEEP_MESSAGES=30
# 工具输出上限（字符）
# TOOL_OUTPUT_MAX_CHARS=12000
# 工具缓存 TTL / 单条上限
# TOOL_CACHE_TTL_SECONDS=600
# TOOL_CACHE_MAX_CHARS=20000
# 文件修改前自动备份到 .agent_backups（默认开启）
# ENABLE_FILE_BACKUPS=true

# ===== 项目规则 =====
# 启动/每轮注入的规则文件（逗号分隔，相对工作区）
# PROJECT_RULES_FILES=AGENTS.md,.agent/rules.md,CLAUDE.md,.cursorrules
